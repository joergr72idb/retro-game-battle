digraph technical_flow {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Retro Game Battle — Server Logic (PAP)\n\n";
  node [fontname="Helvetica", fontsize=11, margin="0.15,0.1"];
  edge [fontname="Helvetica", fontsize=9];
  nodesep=0.45;
  ranksep=0.3;

  start [label="START\nserver boots,\nlistens on TCP :6502\nand HTTP :8080", shape=box, style="rounded,filled", fillcolor="#dbe7f7"];

  method_dec [label="Does the client keep\na TCP socket open?", shape=diamond, style=filled, fillcolor="#dff2e1"];

  tcp_hello [label="TCP path (all clients here:\nAtari, C64, CPC, Apple II):\nHELLO <PLATFORM> <NAME>\n<VARIANT> [PIN]\non a socket that stays open", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];

  http_join [label="HTTP-poll bridge (for slow\nadd-ons, e.g. WiC64 -\nno client here uses it):\nGET /join/<platform>/<name>/\n<variant>/<pin>\n→ \"SESSION <id>\" + reply", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];

  join [label="join()\nshared by both paths", shape=box, peripheries=2, style=filled, fillcolor="#ffffff"];

  filter [label="List the games this VARIANT\nmay play (compatible_variants;\nC64-WIC64: no Snake, no Pong)", shape=box, style=filled, fillcolor="#ffffff"];

  match_dec [label="A player already waiting\nfor a compatible game?", shape=diamond, style=filled, fillcolor="#dff2e1"];

  anyone_dec [label="Anyone waiting\nat all?", shape=diamond, style=filled, fillcolor="#dff2e1"];

  send_list [label="Send WAIT GAMES <n>\n<id>:<label> ...\n(this client picks the game)", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];
  send_err [label="Send ERR INCOMPATIBLE\nGAMES <n> ...\n(the waiting game isn't\nplayable here)", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];

  read_sel [label="Read GAME <n>\n(TCP line, or HTTP\n/tick/<session>/GAME<n>)", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];

  valid_dec [label="n valid?", shape=diamond, style=filled, fillcolor="#dff2e1"];
  retry_dec [label="More than 5\ninvalid tries?", shape=diamond, style=filled, fillcolor="#dff2e1"];
  kick [label="Send ERR TOO MANY\nINVALID SELECTIONS,\nclose connection", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];

  chosen_dec [label="Someone already waiting\nfor exactly that game?", shape=diamond, style=filled, fillcolor="#dff2e1"];
  enqueue [label="Become the waiting player\nfor that game, send WAIT\n(HTTP: keeps polling /tick;\nTCP: socket just stays open)", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];

  rungame [label="run_game(game)\nshared by all games", shape=box, peripheries=2, style=filled, fillcolor="#ffffff"];

  countdown [label="game.init_round(), send\nSTART <game-id> ... to both,\ncountdown 3-2-1 on screen\n(inputs already accepted)", shape=box, style=filled, fillcolor="#ffffff"];

  drain [label="drain_moves(): collect each\nplayer's MOVE / FIRE / BYE\n\nTCP: straight off the socket\nHTTP: whatever the last\n/tick poll delivered\n\nAtari extra, if enabled: hold\neach MOVE back a random delay\n(ATARI_LATENCY_EQUALIZER)", shape=box, style=filled, fillcolor="#ffffff"];

  tick [label="game.tick() every 1/TICK_RATE sec.\n(game plugin, games/<name>.py)\n\nTron / Snake: move, check crashes\nPong: move paddles + ball, score\nArtillery: angle/power, FIRE,\nflight, hit or pass the turn", shape=box, peripheries=2, style=filled, fillcolor="#ffffff"];

  alive_dec [label="Both players\nstill alive?", shape=diamond, style=filled, fillcolor="#dff2e1"];

  outcome_dec [label="Exactly one\nplayer alive?", shape=diamond, style=filled, fillcolor="#dff2e1"];

  send_win [label="Send END WIN <platform> <name>\n+ STATS (for this game)\nto both clients", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];
  send_draw [label="Send END DRAW\n+ STATS (for this game)\nto both clients", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];

  record [label="Append result to\ngame_results.csv\n(with a \"game\" column),\nupdate on-screen totals", shape=box, style=filled, fillcolor="#ffffff"];

  back_wait [label="Return to waiting state:\nscroll text / high-score list /\ntribute screen keep rotating", shape=box, style=filled, fillcolor="#ffffff"];

  end_ [label="back to accepting\nnew connections\n(loops to START)", shape=box, style="rounded,filled", fillcolor="#dbe7f7"];

  start -> method_dec;
  method_dec -> tcp_hello [label="yes"];
  method_dec -> http_join [label="no"];
  tcp_hello -> join;
  http_join -> join;
  join -> filter -> match_dec;
  match_dec -> rungame [label="yes: pair at once,\nno menu"];
  match_dec -> anyone_dec [label="no"];
  anyone_dec -> send_list [label="no"];
  anyone_dec -> send_err [label="yes"];
  send_list -> read_sel;
  send_err -> read_sel;
  read_sel -> valid_dec;
  valid_dec -> retry_dec [label="no"];
  retry_dec -> filter [label="no: resend list", tailport=w, headport=w];
  retry_dec -> kick [label="yes"];
  valid_dec -> chosen_dec [label="yes"];
  chosen_dec -> rungame [label="yes"];
  chosen_dec -> enqueue [label="no"];
  enqueue -> rungame [label="  once a second\n  player joins", style=dashed];
  rungame -> countdown -> drain -> tick -> alive_dec;
  alive_dec -> drain [label="yes", tailport=e, headport=e];
  alive_dec -> outcome_dec [label="no"];
  outcome_dec -> send_win [label="yes"];
  outcome_dec -> send_draw [label="no"];
  send_win -> record;
  send_draw -> record;
  record -> back_wait -> end_;

  subgraph cluster_legend {
    label="PAP symbols";
    fontsize=11;
    style=filled;
    fillcolor="#f7f7f7";
    color="#999999";
    l_term [label="Start / End", shape=box, style="rounded,filled", fillcolor="#dbe7f7", fontsize=10, width=1.5, height=0.4];
    l_proc [label="Process step", shape=box, fillcolor="#ffffff", style=filled, fontsize=10, width=1.5, height=0.4];
    l_sub  [label="Shared subroutine /\ngame plugin", shape=box, peripheries=2, fillcolor="#ffffff", style=filled, fontsize=10, width=1.5, height=0.4];
    l_io   [label="Network message /\nscreen output", shape=parallelogram, style=filled, fillcolor="#fdf1cf", fontsize=10, width=1.5, height=0.4];
    l_dec  [label="Decision", shape=diamond, style=filled, fillcolor="#dff2e1", fontsize=10, width=1.5, height=0.5];
    l_term -> l_proc -> l_sub -> l_io -> l_dec [style=invis];
  }
}
