10 REM ====================================
11 REM  RETRO GAME BATTLE - ATARI CLIENT (v1)
12 REM  SERVER DRAWS THE BOARD - THIS ATARI
13 REM  JUST STEERS. REQUIRES FUJINET N:
14 REM  JOYSTICK IN PORT 1 (OR SET JSPORT)
15 REM ====================================
20 GRAPHICS 0:POKE 82,0
30 DIM URL$(40),HOST$(20),PORTS$(10),NAME$(10),A$(80),D$(10),PIN$(10),TX$(80),TOK$(20),LBL$(20)
40 HOST$="192.168.17.138" :REM <-- EDIT: GAME SERVER IP
50 PORTS$="6502"
60 JSPORT=0 :REM SET TO 1 IF YOUR CONTROLLER SHOWS UP ON STICK(1)
70 NAME$="ATARIXL" :REM <-- EDIT: YOUR PLAYER NAME
80 REM ===== RESTART POINT, REACHED VIA "RUN" (SEE BELOW) =====
81 GRAPHICS 0:POKE 82,0:TRAP 900:DR=0
83 FOR I=1 TO 40:PRINT CHR$(160);:NEXT I
84 PRINT " RETRO GAME BATTLE -"
85 PRINT " CLASSIC COMPUTING 2026"
86 PRINT " ATARI XL / FUJINET EDITION - BUILD 1"
87 FOR I=1 TO 40:PRINT CHR$(160);:NEXT I
88 PRINT
90 REM -- BUILD THE N: URL (STOCK BASIC HAS NO "+",
91 REM    SO WE APPEND VIA STRING-ARRAY INDEXING) --
100 URL$="N:TCP://"
110 URL$(LEN(URL$)+1)=HOST$
120 URL$(LEN(URL$)+1)=":"
130 URL$(LEN(URL$)+1)=PORTS$
140 URL$(LEN(URL$)+1)="/"
145 PRINT "ENTER YOUR PIN OR PRESS ENTER:"
148 INPUT PIN$
165 TX$="CONNECTING TO "
166 TX$(LEN(TX$)+1)=HOST$
167 TX$(LEN(TX$)+1)=":"
168 TX$(LEN(TX$)+1)=PORTS$
169 PRINT TX$
170 TRAP 900
171 OPEN #1,12,2,URL$
178 IF PIN$="" THEN PRINT #1;"HELLO ATARI ";NAME$;" ATARI":GOTO 200
180 PRINT #1;"HELLO ATARI ";NAME$;" ATARI ";PIN$
200 INPUT #1,A$
201 IF A$="WAIT" THEN 200
202 IF LEN(A$)<10 THEN 205
203 IF A$(1,10)="WAIT GAMES" THEN SP=12:GOSUB 1100:GOTO 200
205 IF LEN(A$)<16 THEN 208
206 IF A$(1,16)="ERR INCOMPATIBLE" THEN SP=24:GOSUB 1100:GOTO 200
208 IF A$(1,3)="ERR" THEN PRINT A$:GOTO 545
210 REM -- "START ..." ARRIVED, WE DON'T NEED ITS FIELDS --
220 PRINT "USE JOYSTICK"
240 TRAP 700 :REM FROM HERE, TREAT ANY HICCUP AS A GRACEFUL GAME-OVER
250 DR=0
300 REM ============ MAIN LOOP - STEER + WAIT ============
310 ST=STICK(JSPORT)
320 ND=0
330 IF ST=14 THEN ND=1 :REM UP
340 IF ST=13 THEN ND=2 :REM DOWN
350 IF ST=11 THEN ND=3 :REM LEFT
360 IF ST=7  THEN ND=4 :REM RIGHT
370 IF ND=0 OR ND=DR THEN 400
380 DR=ND
390 GOSUB 1000 :REM SEND THE NEW DIRECTION
400 STATUS #1,SR
410 BW=PEEK(747)*256+PEEK(746)
420 IF BW=0 THEN 300
430 INPUT #1,A$
440 IF A$(1,3)="END" THEN 500
450 GOTO 300
500 REM -- GAME OVER: SHOW RESULT, THEN GRAB STATS LINE --
505 PRINT "GAME OVER"
506 PRINT A$
520 INPUT #1,A$
525 PRINT A$
540 CLOSE #1
545 PRINT "RESTARTING..."
547 FOR DL=1 TO 25:FOR W=1 TO 200:NEXT W:NEXT DL :REM CA. 25 SEK - GIBT DEM
548 REM WLAN-STACK ZEIT, DIE TCP-VERBINDUNG VOLLSTAENDIG ABZUBAUEN
550 RUN
700 REM -- GRACEFUL STOP: HICCUP AFTER GAME START --
710 TX$="CONNECTION ERROR, CODE "
711 TX$(LEN(TX$)+1)=STR$(PEEK(195))
712 PRINT TX$
720 CLOSE #1
725 FOR DL=1 TO 25:FOR W=1 TO 200:NEXT W:NEXT DL
730 RUN
900 REM -- NETWORK / IO ERROR HANDLER (SETUP + GAME-SELECT PHASE) --
910 TX$="NETWORK ERROR, CODE "
911 TX$(LEN(TX$)+1)=STR$(PEEK(195))
912 PRINT TX$
920 CLOSE #1
925 FOR DL=1 TO 25:FOR W=1 TO 200:NEXT W:NEXT DL
930 RUN
1000 REM -- SEND A MOVE COMMAND FOR DIRECTION DR --
1010 D$="MOVE U"
1020 IF DR=2 THEN D$="MOVE D"
1030 IF DR=3 THEN D$="MOVE L"
1040 IF DR=4 THEN D$="MOVE R"
1050 PRINT #1;D$
1060 RETURN
1100 REM -- SHOW GAME MENU FROM A$ (SP = POSITION OF THE GAME-COUNT
1101 REM    DIGIT), READ A CHOICE, SEND "GAME n" TO THE SERVER --
1105 GOSUB 1200 :REM TOK$=GAME COUNT
1110 NG=VAL(TOK$)
1115 IF NG=0 THEN PRINT "NO GAMES AVAILABLE - RESTARTING...":GOTO 545
1120 PRINT "PICK A GAME:"
1125 FOR GI=1 TO NG
1130 GOSUB 1200 :REM TOK$="id:label"
1135 CP=1
1140 IF CP>LEN(TOK$) THEN 1160
1145 IF TOK$(CP,CP)=":" THEN 1160
1150 CP=CP+1:GOTO 1140
1160 LBL$=TOK$(CP+1,LEN(TOK$))
1165 PRINT GI;". ";LBL$
1170 NEXT GI
1175 PRINT "ENTER NUMBER: ";
1180 INPUT NSEL
1185 IF NSEL<1 OR NSEL>NG THEN 1175
1190 PRINT #1;"GAME ";STR$(NSEL)
1195 RETURN
1200 REM -- TOK$ = NEXT SPACE-DELIMITED TOKEN FROM A$ AT SP; ADVANCES SP --
1205 TE=SP
1210 IF TE>LEN(A$) THEN 1225
1215 IF A$(TE,TE)=" " THEN 1225
1220 TE=TE+1:GOTO 1210
1225 TOK$=""
1230 IF TE>SP THEN TOK$=A$(SP,TE-1)
1235 SP=TE+1
1240 RETURN
