10 REM RETRO GAME BATTLE - SCHNEIDER CPC
11 REM SERVER DRAWS THE PLAYFIELD
12 REM THIS CPC ONLY STEERS - VIA
13 REM HTTP POLLING (M4). JOYSTICK
14 REM VIA JOY(0)
20 MODE 1
30 HO$="192.168.17.138" : REM <-- EDIT: SERVER IP
40 PO$="8080" : REM <-- EDIT: HTTP BRIDGE PORT (SEE SERVER STARTUP MESSAGE!)
50 NA$="SCHNEIDERCPC" : REM <-- EDIT: YOUR PLAYER NAME
60 BUF=&8000 : REM SCRATCH MEMORY FOR HTTP RESPONSES
70 BL=200 : REM A GAME LIST NEEDS A BIT MORE ROOM THAN A PLAIN WAIT/START LINE
80 REM -- RESTART POINT, REACHED VIA "RUN" (SEE BELOW) --
90 MODE 1
91 PRINT " RETRO GAME BATTLE -"
92 PRINT " CLASSIC COMPUTING 2026"
93 PRINT " SCHNEIDER CPC EDITION - BUILD 2"
94 PRINT
95 REM -- FLUSH KEY BUFFER: THE JOYSTICK IS PART OF THE KEY MATRIX, SO
96 REM    STEERING DURING THE MATCH LEAVES ARROW CHARS QUEUED, WHICH
97 REM    WOULD OTHERWISE LAND IN THE PIN PROMPT AFTER "RUN"
98 WHILE INKEY$<>"":WEND
100 PRINT "ENTER YOUR PIN OR PRESS ENTER:"
110 INPUT PN$
120 IF PN$="" THEN PN$="NONE"
130 PRINT "CONNECTING..."
140 U$=HO$+":"+PO$+"/join/CPC/"+NA$+"/CPC/"+PN$
150 GOSUB 2000 : REM HTTP GET -> R$
160 IF LEFT$(R$,7)="SESSION" OR LEFT$(R$,7)="session" THEN 220
170 FOR DL=1 TO 3:FOR W=1 TO 2000:NEXT W:NEXT DL:GOTO 130
220 REM -- EXTRACT SESSION ID --
230 SP=1
240 IF MID$(R$,SP,1)=" " THEN 260
250 SP=SP+1:IF SP<=LEN(R$) THEN 240
260 SS=SP+1:SE=SS
270 IF SE>LEN(R$) THEN 300
280 IF MID$(R$,SE,1)=CHR$(10) OR MID$(R$,SE,1)=CHR$(13) THEN 300
290 SE=SE+1:GOTO 270
300 SN$=MID$(R$,SS,SE-SS)
305 REM -- RS$ = WHATEVER CAME AFTER THE "SESSION <ID>" LINE (USUALLY
306 REM    ALREADY A WAIT GAMES LIST, OR EVEN A START IF WE WERE AUTO-
307 REM    MATCHED AS THE SECOND PLAYER - SEE GOSUB 3000 BELOW) --
308 RS$="":IF SE<=LEN(R$) THEN RS$=MID$(R$,SE+1,LEN(R$)-SE)
310 GS=0
315 GOSUB 3000
320 IF LEFT$(RS$,5)="START" OR LEFT$(RS$,5)="start" THEN 340
330 GOTO 400
340 PRINT "USE JOYSTICK":GS=1
400 REM ===== MAIN LOOP =====
405 DR$="N"
410 J=JOY(0)
420 ND$="N"
430 IF (J AND 1)<>0 THEN ND$="U"
440 IF (J AND 2)<>0 THEN ND$="D"
450 IF (J AND 4)<>0 THEN ND$="L"
460 IF (J AND 8)<>0 THEN ND$="R"
470 IF ND$<>"N" THEN DR$=ND$
480 U$=HO$+":"+PO$+"/tick/"+SN$+"/"+DR$
490 GOSUB 2000 : REM HTTP GET -> R$
500 IF R$="" THEN 400
520 IF LEFT$(R$,3)="ERR" OR LEFT$(R$,3)="err" THEN 800
530 IF GS=1 THEN 560
540 IF LEFT$(R$,5)<>"START" AND LEFT$(R$,5)<>"start" THEN 560
550 PRINT "USE JOYSTICK":GS=1
560 IF LEFT$(R$,3)<>"END" AND LEFT$(R$,3)<>"end" THEN 400
600 REM -- GAME OVER: SHOW RESULT, THEN RESTART --
610 PRINT "GAME OVER":PRINT R$
630 PRINT "RESTARTING..."
650 FOR DL=1 TO 3:FOR W=1 TO 2000:NEXT W:NEXT DL : REM ~3 SEC, ADJUST IF NEEDED
660 RUN
800 PRINT "RESTARTING...":RUN
2000 REM -- HTTP GET U$ -> R$ (M4, |HTTPMEM) --
2010 FOR ZI=0 TO BL-1
2020 POKE BUF+ZI,0
2030 NEXT ZI
2040 |HTTPMEM,U$,BUF,BL
2050 R$=""
2060 FOR ZI=0 TO BL-1
2070 BY=PEEK(BUF+ZI)
2080 IF BY=0 THEN 2110
2090 R$=R$+CHR$(BY)
2100 NEXT ZI
2110 RETURN
3000 REM -- INTERPRET RS$, LOOPING THROUGH GAME-SELECTION ROUNDS UNTIL
3001 REM    A TERMINAL STATE (PLAIN "WAIT" OR A "START ..." LINE) --
3010 IF LEFT$(RS$,10)="WAIT GAMES" OR LEFT$(RS$,10)="wait games" THEN SP=12:GOSUB 4000:GOTO 3010
3020 IF LEFT$(RS$,16)="ERR INCOMPATIBLE" OR LEFT$(RS$,16)="err incompatible" THEN SP=24:GOSUB 4000:GOTO 3010
3030 IF RS$="WAIT" OR RS$="wait" THEN PRINT "WAITING FOR OPPONENT...":RETURN
3040 IF LEFT$(RS$,3)="ERR" OR LEFT$(RS$,3)="err" THEN PRINT RS$:GOTO 800
3050 RETURN
4000 REM -- PARSE GAME LIST FROM RS$ AT SP, SHOW MENU, READ CHOICE,
4001 REM    SEND IT AS /tick/<session>/GAME<n> --
4010 GOSUB 4200 : REM TOK$=GAME COUNT
4020 NG=VAL(TOK$)
4030 IF NG=0 THEN PRINT "NO GAMES AVAILABLE - RESTARTING...":GOTO 800
4040 PRINT "PICK A GAME:"
4050 FOR GI=1 TO NG
4060 GOSUB 4200 : REM TOK$="id:label"
4070 CP=1
4080 IF MID$(TOK$,CP,1)=":" THEN 4110
4090 CP=CP+1
4095 IF CP<=LEN(TOK$) THEN 4080
4110 LBL$=MID$(TOK$,CP+1,LEN(TOK$)-CP)
4120 PRINT GI;". ";LBL$
4130 NEXT GI
4140 PRINT "ENTER NUMBER";
4145 WHILE INKEY$<>"":WEND : REM FLUSH JOYSTICK CHARS (SEE LINE 95)
4150 INPUT NSEL
4160 IF NSEL<1 OR NSEL>NG THEN 4140
4170 NS$=MID$(STR$(NSEL),2) : REM STR$() RESERVES A LEADING SIGN SPACE - STRIP IT
4180 U$=HO$+":"+PO$+"/tick/"+SN$+"/GAME"+NS$
4190 GOSUB 2000 : REM HTTP GET -> R$
4195 RS$=R$
4199 RETURN
4200 REM -- TOK$ = NEXT SPACE-DELIMITED TOKEN FROM RS$ AT SP; ADVANCES SP --
4210 TE=SP
4220 IF TE>LEN(RS$) THEN 4250
4230 IF MID$(RS$,TE,1)=" " THEN 4250
4240 TE=TE+1:GOTO 4220
4250 TOK$=""
4260 IF TE>SP THEN TOK$=MID$(RS$,SP,TE-SP)
4270 SP=TE+1
4280 RETURN
